{
  "name": "coaching-skeleton",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:types": "tsc -b && tsx scripts/checkSchemaSync.ts && tsx scripts/checkPermissionSync.ts",
    "test:permissions": "tsx scripts/checkPermissionSync.ts",
    "verify:schema": "bash scripts/verifySchema.sh",
    "preview": "vite preview",
    "seed": "tsx scripts/seedSupabase.ts",
    "seed:universities": "tsx scripts/seedUniversityRankings.ts",
    "backup": "tsx scripts/backupData.ts",
    "restore": "tsx scripts/restoreData.ts",
    "generate:access-codes": "tsx scripts/generateAccessCodes.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
